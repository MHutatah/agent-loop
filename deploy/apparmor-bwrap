# Ubuntu 24.04 restricts unprivileged user namespaces by default
# (kernel.apparmor_restrict_unprivileged_userns=1), which stops bubblewrap from
# creating the sandbox Codex runs its agents in — the agent fails with
# "bwrap: loopback: Failed RTM_NEWADDR: Operation not permitted".
#
# Grant the capability to THIS BINARY ONLY rather than disabling the restriction
# system-wide: the host may run other production services, so hardening stays on
# for everything else, and agents keep their sandbox rather than being run with
# --sandbox danger-full-access.
#
# Install: sudo cp deploy/apparmor-bwrap /etc/apparmor.d/bwrap
#          sudo apparmor_parser -r /etc/apparmor.d/bwrap
abi <abi/4.0>,
include <tunables/global>

profile bwrap /usr/bin/bwrap flags=(unconfined) {
  userns,
  include if exists <local/bwrap>
}
